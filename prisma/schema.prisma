// PLAYBOY STORE — schema do banco de dados (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: conexão via pooler (Supabase: porta 6543, ?pgbouncer=true) usada pela aplicação.
// DIRECT_URL: conexão direta (porta 5432) usada pelo Prisma Migrate.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Usuários & autenticação

enum Role {
  ADMIN
  CUSTOMER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  passwordHash     String
  role             Role          @default(CUSTOMER)
  // Permissões administrativas granulares (ver lib/permissions.ts). "*" = super admin.
  permissions      String[]      @default([])
  status           AccountStatus @default(ACTIVE)
  phone            String?
  // CPF ou CNPJ (somente números). Exigido pelo gateway de pagamento no checkout.
  document         String?
  emailVerifiedAt  DateTime?
  lastActiveAt     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessions     Session[]
  tokens       AuthToken[]
  orders       Order[]
  reviews      Review[]
  favorites    Favorite[]
  cart         Cart?
  auditLogs    AuditLog[]

  @@index([role])
  @@index([createdAt])
}

model Session {
  id         String   @id // hash SHA-256 do token do cookie
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

model AuthToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

// ───────────────────────────── Catálogo

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortDescription String
  description      String
  priceCents       Int
  // Desconto percentual opcional (0–90). O preço final é calculado em lib/pricing.ts.
  discountPercent  Int      @default(0)
  sku              String?  @unique
  stock            Int      @default(0)
  active           Boolean  @default(true)
  featured         Boolean  @default(false)
  platform         String?
  deliveryType     String   @default("Entrega digital imediata")
  // Lista de pares { label, value } exibida em "Informações detalhadas".
  specs            Json     @default("[]")
  salesCount       Int      @default(0)
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  images     ProductImage[]
  reviews    Review[]
  favorites  Favorite[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([active, featured])
  @@index([categoryId])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model Favorite {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

// ───────────────────────────── Carrinho & pedidos

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponCode String?
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([cartId, productId])
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  description   String?
  type          CouponType
  // PERCENT: 1–100 | FIXED: centavos
  value         Int
  minOrderCents Int        @default(0)
  maxUses       Int?
  usedCount     Int        @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  orders        Order[]
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
}

model Order {
  id             String        @id @default(cuid())
  number         Int           @unique @default(autoincrement())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  customerName   String
  customerEmail  String
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  paymentMethod  PaymentMethod
  subtotalCents  Int
  discountCents  Int           @default(0)
  totalCents     Int
  couponId       String?
  coupon         Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode     String?
  notes          String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items    OrderItem[]
  payments Payment[]
  history  OrderStatusHistory[]

  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  unitPriceCents Int
  quantity       Int
  totalCents     Int

  @@index([productId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  method      PaymentMethod
  amountCents Int
  status      PaymentStatus @default(PENDING)
  providerRef  String?       @unique
  // Instruções retornadas pelo provedor (código Pix, linha digitável etc.)
  instructions Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdBy String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ───────────────────────────── CRM & marketing

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  CONVERTED
  LOST
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  source    String
  interest  String?
  status    LeadStatus @default(NEW)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  ctaLabel  String?
  ctaUrl    String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Registro de visitas (para taxa de conversão visitante → comprador)
model Visit {
  id        String   @id @default(cuid())
  visitorId String
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
}

// ───────────────────────────── Configurações & auditoria

model StoreSettings {
  id                 Int      @id @default(1)
  storeName          String   @default("PLAYBOY STORE")
  tagline            String   @default("A loja gamer premium.")
  logoUrl            String?
  accentColor        String   @default("#ffffff")
  backgroundColor    String   @default("#080808")
  contactEmail       String   @default("contato@playboystore.com.br")
  contactPhone       String?
  whatsapp           String?
  companyName        String?
  companyDocument    String?
  address            String?
  businessHours      String?
  instagramUrl       String?
  discordUrl         String?
  youtubeUrl         String?
  notifyNewOrder     Boolean  @default(true)
  notifyNewLead      Boolean  @default(true)
  notifyLowStock     Boolean  @default(true)
  lowStockThreshold  Int      @default(5)
  notificationEmail  String?
  // Aviso de compras recentes na loja (apenas pedidos pagos reais)
  purchasePopupEnabled Boolean @default(true)
  purchasePopupMinutes Int     @default(20)
  updatedAt          DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
}

// Caixa de saída: todo e-mail enviado fica registrado (útil sem SMTP configurado)
model EmailMessage {
  id        String   @id @default(cuid())
  to        String
  subject   String
  html      String
  status    String   @default("logged")
  createdAt DateTime @default(now())
}
