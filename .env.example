# ───────── Banco de dados
# Local (npm run db:local): as duas URLs são iguais.
LOCAL_DB_PORT=5433
LOCAL_DB_PASSWORD=troque-esta-senha
DATABASE_URL="postgresql://postgres:troque-esta-senha@localhost:5433/playboystore?schema=public"
DIRECT_URL="postgresql://postgres:troque-esta-senha@localhost:5433/playboystore?schema=public"

# Supabase (Project Settings → Database → Connection string):
# DATABASE_URL = Transaction pooler (porta 6543) + ?pgbouncer=true&connection_limit=1
# DIRECT_URL   = Session pooler ou conexão direta (porta 5432)
# DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# ───────── Aplicação
# URL pública (usada nos links dos e-mails). Na Vercel, use o domínio de produção.
APP_URL="http://localhost:3000"

# ───────── Supabase Storage (uploads de imagens do painel)
# Vazio = salva em storage/uploads (somente local; na Vercel o disco não é persistente).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"

# ───────── Seed (somente para rodar npm run db:seed, não precisa na Vercel)
SEED_ADMIN_EMAIL="admin@playboystore.local"
SEED_ADMIN_PASSWORD="defina-uma-senha-forte"
SEED_CUSTOMER_EMAIL="cliente@playboystore.local"
SEED_CUSTOMER_PASSWORD="defina-uma-senha"

# ───────── E-mail (opcional). Sem SMTP, os e-mails ficam em Admin → E-mails enviados.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PLAYBOY STORE <no-reply@playboystore.com.br>"

# ───────── Pagamentos
# "manual" = Pix manual (o admin confirma o pagamento no painel). Padrão em produção.
# "sandbox" = simulado, para testes. Bloqueado em produção (exceto com ALLOW_SANDBOX_PAYMENTS="true").
PAYMENT_PROVIDER="sandbox"
PAYMENT_WEBHOOK_SECRET=""
PIX_KEY=""
PIX_KEY_HOLDER=""
