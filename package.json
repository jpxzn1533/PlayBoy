{
  "name": "playboy-store",
  "version": "1.0.0",
  "private": true,
  "description": "PLAYBOY STORE — plataforma e-commerce gamer premium",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/local-db.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:seed:demo": "tsx --env-file=.env prisma/seed.ts --demo",
    "db:deploy:prod": "node --env-file=.env.production.local node_modules/prisma/build/index.js migrate deploy",
    "db:seed:prod": "tsx --env-file=.env.production.local prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "next": "15.5.28",
    "nodemailer": "7.0.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "3.2.1",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/nodemailer": "7.0.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "embedded-postgres": "17.11.0-beta.19",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true,
    "@embedded-postgres/windows-x64@17.11.0-beta.19": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@tailwindcss/oxide@4.1.13": true
  }
}
